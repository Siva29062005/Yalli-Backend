# Copy to .env (or run scripts/setup-dev-env.sh to generate one with random dev passwords).
# NEVER commit real values. Production secrets come from a secrets manager (AWS Secrets Manager), not files.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Human-readable dev logs (pino-pretty). Must be false/absent in production images.
LOG_PRETTY=true

# --- Infrastructure (docker-compose publishes these on 127.0.0.1 only) -------------------------
POSTGRES_SUPERUSER_PASSWORD=__generated__
POSTGRES_MIGRATOR_PASSWORD=__generated__
POSTGRES_APP_PASSWORD=__generated__
POSTGRES_REPORTING_PASSWORD=__generated__
REDIS_PASSWORD=__generated__
RABBITMQ_USER=yalli
RABBITMQ_PASSWORD=__generated__

# Unpaid orders one customer may hold at once (each reserves stock for the payment window).
MAX_OPEN_UNPAID_ORDERS=3

# --- Application (runtime role: DML only, cannot change schema) ---------------------------------
DATABASE_URL=postgresql://yalli_app:__POSTGRES_APP_PASSWORD__@localhost:5432/yalli
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://:__REDIS_PASSWORD__@localhost:6379
RABBITMQ_URL=amqp://yalli:__RABBITMQ_PASSWORD__@localhost:5672

# --- Migrations only (DDL role). Never give this to the running application. ---------------------
DATABASE_MIGRATION_URL=postgresql://yalli_migrator:__POSTGRES_MIGRATOR_PASSWORD__@localhost:5432/yalli

# --- Authentication (Phase 3) ------------------------------------------------------------------
# Generated by scripts/setup-dev-env.sh. In production these come from AWS Secrets Manager / KMS - never a file.
JWT_KEY_ID=dev-1
# Ed25519 private key (PKCS#8 PEM), base64. Rotate: new JWT_KEY_ID + key; move the old PUBLIC key into the JSON below.
JWT_PRIVATE_KEY_B64=__generated__
JWT_RETIRED_PUBLIC_KEYS_JSON={}
JWT_ISSUER=yalli-api
JWT_AUDIENCE=yalli-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_ABSOLUTE_TTL_DAYS=30
REFRESH_IDLE_TTL_DAYS=7
# 32 random bytes, base64. Encrypts TOTP secrets at rest (AES-256-GCM).
MFA_ENCRYPTION_KEY_B64=__generated__
MFA_ENCRYPTION_KEY_ID=k1
MFA_ISSUER=Yalli
# Cookie-mode (browser) refresh tokens. Secure cookies are mandatory in production (localhost is fine over http in Chrome).
COOKIE_SECURE=false
# Bot protection. `none` is development only; production requires turnstile + a secret.
CAPTCHA_PROVIDER=none
# TURNSTILE_SECRET=
# Breached-password lookup (k-anonymity API). Required in production.
HIBP_ENABLED=false
# `console` prints verification links / OTPs to stdout: DEVELOPMENT ONLY (production refuses it).
# `ses_msg91` sends email through Amazon SES and OTP SMS through MSG91; set the variables below.
NOTIFICATIONS_DRIVER=console
# AWS_REGION=ap-south-1
# SES_FROM_ADDRESS=no-reply@yalli.in          # must be a verified SES identity; credentials come from the AWS role, never from .env
# SES_CONFIGURATION_SET=
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=                      # DLT-approved flow template with a single variable `otp`
FRONTEND_BASE_URL=http://localhost:5173

# First SUPER_ADMIN, consumed once by `npm run seed` (leave unset otherwise). Rotate the password after first sign-in.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Commerce (Phase 4) ------------------------------------------------------------------------
# In-process background jobs (reservation expiry sweeper).
BACKGROUND_JOBS_ENABLED=true
# Image storage. `local` is development only (production requires an object store).
STORAGE_DRIVER=local
UPLOADS_DIR=./storage/uploads
MEDIA_BASE_URL=http://localhost:3000/media

# --- Payments, orders, events (Phase 5) ----------------------------------------------------------
# Razorpay (https://dashboard.razorpay.com). Use TEST-mode keys in development. Without them, orders work but
# starting a payment returns 503 PAYMENT_PROVIDER_UNAVAILABLE. Production: from the secrets manager only.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook: Dashboard -> Settings -> Webhooks -> URL https://<api-host>/api/v1/webhooks/razorpay,
# events: payment.authorized, payment.captured, payment.failed, refund.processed, refund.failed. Secret = this value.
# RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WINDOW_MINUTES=30
RETURN_WINDOW_DAYS=7
SELLER_STATE=Tamil Nadu
# SELLER_GSTIN=33ABCDE1234F1Z5
# rabbitmq = publish outbox events to the broker (compose provides it); memory = no broker (tests only).
EVENT_BUS_DRIVER=rabbitmq

# --- HTTP ---------------------------------------------------------------------------------------
# Comma-separated EXACT origins. Wildcards are rejected. Production requires https:// origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Reverse-proxy hops to trust for X-Forwarded-For (0 = none). Set to 1 behind Nginx/ALB.
TRUST_PROXY_HOPS=0
# Swagger UI at /docs. Forbidden in production.
SWAGGER_ENABLED=true
REQUEST_BODY_LIMIT_KB=100
REQUEST_TIMEOUT_MS=30000
