// Phase 2 (foundation) schema: cross-cutting infrastructure tables only.
// Domain tables (users, products, orders, ...) are added phase by phase.
//
// Constraints that Prisma cannot express (append-only triggers, CHECKs, partial
// indexes, role grants) live in hand-written SQL inside the migration files.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Append-only security/financial audit trail. UPDATE/DELETE are blocked by trigger + revoked grants.
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId       String?  @map("actor_id") @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(32)
  action        String   @db.VarChar(100)
  resourceType  String?  @map("resource_type") @db.VarChar(64)
  resourceId    String?  @map("resource_id") @db.VarChar(128)
  outcome       String   @db.VarChar(16)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  /// Must never contain credentials, tokens or payment data.
  metadata      Json?

  @@index([actorId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

/// Transactional outbox: written in the same transaction as the business change,
/// relayed to RabbitMQ by a worker (at-least-once delivery).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(100)
  eventVersion  Int       @default(1) @map("event_version")
  payload       Json
  correlationId String?   @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(1000)
  /// Retry scheduling: the relay skips events whose time has not come (exponential backoff).
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  // Partial index (WHERE published_at IS NULL) is added in raw SQL in the migration.
  @@index([createdAt])
  @@map("outbox_events")
}

/// Idempotency records for unsafe endpoints (checkout, payments, refunds).
model IdempotencyRecord {
  id           String   @id @default(uuid(7)) @db.Uuid
  scope        String   @db.VarChar(100)
  key          String   @db.VarChar(128)
  actorId      String   @map("actor_id") @db.Uuid
  requestHash  String   @map("request_hash") @db.VarChar(64)
  status       String   @db.VarChar(16)
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([scope, actorId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ============================================================================================
// Phase 3: identity, sessions, MFA, RBAC
// ============================================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_OTP
}

enum MfaMethodStatus {
  PENDING
  ACTIVE
}

/// Authentication identity. Profile data lives in `customers` (separate concern).
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @db.VarChar(254)
  /// Lower-cased, NFKC-normalised, trimmed. The uniqueness key.
  emailNormalized   String     @unique @map("email_normalized") @db.VarChar(254)
  phoneE164         String?    @map("phone_e164") @db.VarChar(20)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer           Customer?
  roles              UserRole[]
  sessions           UserSession[]
  verificationTokens VerificationToken[]
  mfaMethods         MfaMethod[]
  mfaRecoveryCodes   MfaRecoveryCode[]
  consents           Consent[]
  addresses          Address[]
  cart               Cart?
  couponRedemptions  CouponRedemption[]
  orders             Order[]
  returnRequests     ReturnRequest[]
  reviews            ProductReview[]
  wishlist           WishlistItem[]

  @@map("users")
}

model Customer {
  id                   String   @id @default(uuid(7)) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  firstName            String   @map("first_name") @db.VarChar(60)
  lastName             String   @map("last_name") @db.VarChar(60)
  newsletterSubscribed Boolean  @default(false) @map("newsletter_subscribed")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("customers")
}

/// Evidence of consent (privacy policy, terms, marketing). Append-only by convention.
model Consent {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   @db.VarChar(40)
  version    String   @db.VarChar(20)
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ip         String?  @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type])
  @@map("consents")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(200)
  /// Higher rank = more privileged. A user may only manage roles ranked below their own (SUPER_ADMIN excepted).
  rank        Int
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One row per login/device. A session owns a chain ("family") of rotating refresh tokens.
model UserSession {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceLabel     String?   @map("device_label") @db.VarChar(100)
  userAgent       String?   @map("user_agent") @db.VarChar(512)
  /// Stable hash of the user agent, used to recognise "new device" logins without storing more PII.
  deviceHash      String    @map("device_hash") @db.VarChar(64)
  ip              String?   @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute lifetime: the session can never outlive this, however often it is refreshed.
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?   @map("revoked_reason") @db.VarChar(40)
  mfaVerified     Boolean   @default(false) @map("mfa_verified")
  /// Last time the user actually proved their identity (login or step-up). Drives `auth_time` in access tokens.
  authenticatedAt DateTime  @default(now()) @map("authenticated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([userId, deviceHash])
  @@map("user_sessions")
}

/// Only the SHA-256 of the opaque token is stored. A used token that is presented again = theft signal.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use, expiring, hashed tokens: email verification, password reset, phone OTP.
model VerificationToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(64)
  /// Destination the token was sent to (email address / E.164 phone) so a later change invalidates it.
  target    String       @db.VarChar(254)
  attempts  Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model MfaMethod {
  id           String          @id @default(uuid(7)) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  type         String          @default("TOTP") @db.VarChar(16)
  /// AES-256-GCM envelope: "<keyId>.<iv>.<ciphertext>.<tag>" (base64url). Never plaintext.
  secretEnc    String          @map("secret_enc") @db.VarChar(512)
  status       MfaMethodStatus @default(PENDING)
  /// Last accepted TOTP time-step; codes at or before it are rejected (replay protection).
  lastUsedStep BigInt?         @map("last_used_step")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt  DateTime?       @map("confirmed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("mfa_methods")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recovery_codes")
}

// ============================================================================================
// Phase 4: customers, catalog, inventory, cart, coupons
// All money is INTEGER PAISE (INR minor units). There are no floating-point money columns anywhere.
// ============================================================================================

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  ALL_ITEMS
  PRODUCTS
  CATEGORIES
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVE
  RELEASE
  COMMIT
  EXPIRE
  RETURN
}

model Address {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  label       String?   @db.VarChar(40)
  fullName    String    @map("full_name") @db.VarChar(120)
  phoneE164   String    @map("phone_e164") @db.VarChar(20)
  line1       String    @db.VarChar(200)
  line2       String?   @db.VarChar(200)
  landmark    String?   @db.VarChar(120)
  city        String    @db.VarChar(80)
  state       String    @db.VarChar(60)
  postalCode  String    @map("postal_code") @db.VarChar(10)
  countryCode String    @default("IN") @map("country_code") @db.Char(2)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("addresses")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]
  coupons  CouponCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique @db.VarChar(160)
  name            String        @db.VarChar(200)
  summary         String?       @db.VarChar(500)
  /// Sanitised on write (allow-list). Still escaped/encoded by every consumer that renders it.
  descriptionHtml String        @default("") @map("description_html") @db.Text
  brandId         String?       @map("brand_id") @db.Uuid
  status          ProductStatus @default(DRAFT)
  /// GST rate in basis points (1800 = 18%). Prices are GST-INCLUSIVE, as displayed on the storefront.
  gstRateBps      Int           @default(1800) @map("gst_rate_bps")
  hsnCode         String?       @map("hsn_code") @db.VarChar(10)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  brand      Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  images     ProductImage[]
  categories ProductCategory[]
  tags       ProductTag[]
  attributes ProductAttribute[]
  coupons    CouponProduct[]
  reviews    ProductReview[]
  wishlisted WishlistItem[]

  @@index([status, deletedAt, publishedAt(sort: Desc)])
  @@index([brandId])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Tag {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique @db.VarChar(60)

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

/// Specification rows ("Material: Silicone").
model ProductAttribute {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String @db.VarChar(80)
  value     String @db.VarChar(300)
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model ProductVariant {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  /// Unique case-insensitively (see lower(sku) index in the migration).
  sku            String    @db.VarChar(64)
  name           String?   @db.VarChar(120)
  priceMinor     Int       @map("price_minor")
  salePriceMinor Int?      @map("sale_price_minor")
  saleStartsAt   DateTime? @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt     DateTime? @map("sale_ends_at") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("is_active")
  position       Int       @default(0)
  optionValues   Json?     @map("option_values")
  weightGrams    Int?      @map("weight_grams")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory[]
  movements    InventoryMovement[]
  reservations InventoryReservation[]
  cartItems    CartItem[]
  images       ProductImage[]

  @@index([productId, deletedAt])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  /// Server-generated object key (never derived from the client's filename).
  storageKey String   @unique @map("storage_key") @db.VarChar(120)
  mimeType   String   @map("mime_type") @db.VarChar(40)
  sizeBytes  Int      @map("size_bytes")
  altText    String?  @map("alt_text") @db.VarChar(200)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_images")
}

model Warehouse {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inventory    Inventory[]
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@map("warehouses")
}

/// PostgreSQL is the AUTHORITATIVE stock record. `available = on_hand - reserved`.
model Inventory {
  id                String   @id @default(uuid(7)) @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId])
  @@map("inventory")
}

/// Append-only ledger of every stock change (trigger-protected).
model InventoryMovement {
  id            String                @id @default(uuid(7)) @db.Uuid
  variantId     String                @map("variant_id") @db.Uuid
  warehouseId   String                @map("warehouse_id") @db.Uuid
  type          InventoryMovementType
  onHandDelta   Int                   @map("on_hand_delta")
  reservedDelta Int                   @map("reserved_delta")
  onHandAfter   Int                   @map("on_hand_after")
  reservedAfter Int                   @map("reserved_after")
  reason        String?               @db.VarChar(200)
  referenceType String?               @map("reference_type") @db.VarChar(40)
  referenceId   String?               @map("reference_id") @db.VarChar(64)
  actorId       String?               @map("actor_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

model InventoryReservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  quantity      Int
  status        ReservationStatus @default(RESERVED)
  referenceType String            @map("reference_type") @db.VarChar(40)
  referenceId   String            @map("reference_id") @db.VarChar(64)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([referenceType, referenceId, variantId, warehouseId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

model Cart {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Exactly one of userId / guestTokenHash is set.
  userId         String?  @unique @map("user_id") @db.Uuid
  guestTokenHash String?  @unique @map("guest_token_hash") @db.VarChar(64)
  couponCode     String?  @map("coupon_code") @db.VarChar(40)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Coupon {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Stored UPPER-CASE; lookups normalise the same way.
  code             String       @unique @db.VarChar(40)
  description      String?      @db.VarChar(200)
  discountType     DiscountType @map("discount_type")
  percentBps       Int?         @map("percent_bps")
  amountMinor      Int?         @map("amount_minor")
  maxDiscountMinor Int?         @map("max_discount_minor")
  scope            CouponScope  @default(ALL_ITEMS)
  minCartMinor     Int          @default(0) @map("min_cart_minor")
  startsAt         DateTime?    @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime?    @map("expires_at") @db.Timestamptz(6)
  maxRedemptions   Int?         @map("max_redemptions")
  redeemedCount    Int          @default(0) @map("redeemed_count")
  perCustomerLimit Int?         @map("per_customer_limit")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  products    CouponProduct[]
  categories  CouponCategory[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponProduct {
  couponId  String @map("coupon_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String @map("coupon_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponRedemption {
  id            String   @id @default(uuid(7)) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  referenceType String   @map("reference_type") @db.VarChar(40)
  referenceId   String   @map("reference_id") @db.VarChar(64)
  discountMinor Int      @map("discount_minor")
  redeemedAt    DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([couponId, referenceType, referenceId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ============================================================================================
// Phase 5: checkout, orders, payments, refunds, returns
// ============================================================================================

enum OrderStatus {
  CREATED
  INVENTORY_RESERVED
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  PROCESSED
  FAILED
  REJECTED
}

enum RefundKind {
  CUSTOMER_CANCEL
  LATE_CAPTURE
  RETURN
  GOODWILL
  ADMIN
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum ReturnReason {
  DEAD_ON_ARRIVAL
  FAULTY
  ORDER_ERROR
  WRONG_ITEM
  OTHER
}

/// An order is a SNAPSHOT: prices, names, tax and the shipping address are copied at purchase time and never re-derived.
model Order {
  id                  String       @id @default(uuid(7)) @db.Uuid
  orderNumber         String       @unique @map("order_number") @db.VarChar(20)
  userId              String       @map("user_id") @db.Uuid
  status              OrderStatus  @default(CREATED)
  /// Where the order was before a refund began (so a refund that fails can revert).
  statusBeforeRefund  OrderStatus? @map("status_before_refund")
  currency            String       @default("INR") @db.Char(3)
  subtotalMinor       Int          @map("subtotal_minor")
  discountMinor       Int          @default(0) @map("discount_minor")
  shippingMinor       Int          @default(0) @map("shipping_minor")
  gstIncludedMinor    Int          @map("gst_included_minor")
  totalMinor          Int          @map("total_minor")
  couponId            String?      @map("coupon_id") @db.Uuid
  couponCode          String?      @map("coupon_code") @db.VarChar(40)
  contactEmail        String       @map("contact_email") @db.VarChar(254)
  contactPhone        String?      @map("contact_phone") @db.VarChar(20)
  shipName            String       @map("ship_name") @db.VarChar(120)
  shipPhone           String       @map("ship_phone") @db.VarChar(20)
  shipLine1           String       @map("ship_line1") @db.VarChar(200)
  shipLine2           String?      @map("ship_line2") @db.VarChar(200)
  shipLandmark        String?      @map("ship_landmark") @db.VarChar(120)
  shipCity            String       @map("ship_city") @db.VarChar(80)
  shipState           String       @map("ship_state") @db.VarChar(60)
  shipPostalCode      String       @map("ship_postal_code") @db.VarChar(10)
  shipCountry         String       @default("IN") @map("ship_country") @db.Char(2)
  /// Unpaid orders release their stock reservation at this time.
  paymentExpiresAt    DateTime     @map("payment_expires_at") @db.Timestamptz(6)
  placedAt            DateTime     @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt              DateTime?    @map("paid_at") @db.Timestamptz(6)
  shippedAt           DateTime?    @map("shipped_at") @db.Timestamptz(6)
  deliveredAt         DateTime?    @map("delivered_at") @db.Timestamptz(6)
  cancelledAt         DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?      @map("cancel_reason") @db.VarChar(200)
  inventoryReleasedAt DateTime?    @map("inventory_released_at") @db.Timestamptz(6)
  trackingCarrier     String?      @map("tracking_carrier") @db.VarChar(60)
  trackingNumber      String?      @map("tracking_number") @db.VarChar(80)
  /// Snapshot of the delivery method chosen at checkout (null = shipping was not configured, i.e. free).
  shippingMethodCode  String?      @map("shipping_method_code") @db.VarChar(30)
  shippingMethodName  String?      @map("shipping_method_name") @db.VarChar(80)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  history  OrderStatusHistory[]
  payments Payment[]
  refunds  Refund[]
  returns  ReturnRequest[]
  shipment Shipment?

  @@index([userId, placedAt(sort: Desc)])
  @@index([status, paymentExpiresAt])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid(7)) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  variantId         String  @map("variant_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  sku               String  @db.VarChar(64)
  productName       String  @map("product_name") @db.VarChar(200)
  variantName       String? @map("variant_name") @db.VarChar(120)
  imageKey          String? @map("image_key") @db.VarChar(120)
  hsnCode           String? @map("hsn_code") @db.VarChar(10)
  unitPriceMinor    Int     @map("unit_price_minor")
  compareAtMinor    Int?    @map("compare_at_minor")
  quantity          Int
  lineSubtotalMinor Int     @map("line_subtotal_minor")
  lineDiscountMinor Int     @default(0) @map("line_discount_minor")
  lineTotalMinor    Int     @map("line_total_minor")
  gstRateBps        Int     @map("gst_rate_bps")
  gstIncludedMinor  Int     @map("gst_included_minor")
  cgstMinor         Int     @default(0) @map("cgst_minor")
  sgstMinor         Int     @default(0) @map("sgst_minor")
  igstMinor         Int     @default(0) @map("igst_minor")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returns ReturnRequest[]

  @@index([orderId])
  @@map("order_items")
}

/// Append-only (trigger-protected): who moved an order between states, when and why.
model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  String       @map("actor_type") @db.VarChar(16)
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?      @db.VarChar(200)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @db.VarChar(20)
  providerOrderId   String?       @unique @map("provider_order_id") @db.VarChar(64)
  providerPaymentId String?       @unique @map("provider_payment_id") @db.VarChar(64)
  status            PaymentStatus @default(CREATED)
  amountMinor       Int           @map("amount_minor")
  currency          String        @default("INR") @db.Char(3)
  capturedMinor     Int           @default(0) @map("captured_minor")
  /// Refunded PLUS refunds in flight: the counter a refund must fit under (DB CHECK: never above captured).
  refundedMinor     Int           @default(0) @map("refunded_minor")
  attempt           Int           @default(1)
  method            String?       @db.VarChar(30)
  failureCode       String?       @map("failure_code") @db.VarChar(80)
  failureReason     String?       @map("failure_reason") @db.VarChar(300)
  idempotencyKey    String?       @map("idempotency_key") @db.VarChar(128)
  /// Claim taken by the ONE request that is creating the provider order (prevents orphaned, payable provider orders).
  initiatingAt      DateTime?     @map("initiating_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  capturedAt        DateTime?     @map("captured_at") @db.Timestamptz(6)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([orderId, attempt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Immutable financial audit trail (trigger-protected). Payloads are allow-list sanitised: no card/UPI/contact data.
model PaymentEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  paymentId       String?  @map("payment_id") @db.Uuid
  provider        String   @db.VarChar(20)
  providerEventId String?  @map("provider_event_id") @db.VarChar(80)
  type            String   @db.VarChar(60)
  fromStatus      String?  @map("from_status") @db.VarChar(30)
  toStatus        String?  @map("to_status") @db.VarChar(30)
  source          String   @db.VarChar(20)
  data            Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

/// Webhook de-duplication. The unique key makes processing a provider event twice impossible.
model WebhookInbox {
  id              String   @id @default(uuid(7)) @db.Uuid
  provider        String   @db.VarChar(20)
  providerEventId String   @map("provider_event_id") @db.VarChar(80)
  eventType       String   @map("event_type") @db.VarChar(60)
  outcome         String?  @db.VarChar(40)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@map("webhook_inbox")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  returnRequestId  String?      @map("return_request_id") @db.Uuid
  kind             RefundKind
  amountMinor      Int          @map("amount_minor")
  reason           String       @db.VarChar(200)
  status           RefundStatus @default(PENDING_APPROVAL)
  requestedById    String?      @map("requested_by_id") @db.Uuid
  approvedById     String?      @map("approved_by_id") @db.Uuid
  rejectionReason  String?      @map("rejection_reason") @db.VarChar(200)
  providerRefundId String?      @unique @map("provider_refund_id") @db.VarChar(64)
  /// Our own reference sent to the provider so an ambiguous failure can be matched later.
  receipt          String       @unique @db.VarChar(40)
  idempotencyKey   String       @unique @map("idempotency_key") @db.VarChar(128)
  failureReason    String?      @map("failure_reason") @db.VarChar(300)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

model ReturnRequest {
  id           String       @id @default(uuid(7)) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  orderItemId  String       @map("order_item_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  quantity     Int
  reason       ReturnReason
  opened       Boolean
  details      String?      @db.VarChar(1000)
  status       ReturnStatus @default(REQUESTED)
  decidedById  String?      @map("decided_by_id") @db.Uuid
  decisionNote String?      @map("decision_note") @db.VarChar(300)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  item  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user  User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("return_requests")
}

/// Idempotent consumers: a message id is processed at most once per consumer (delivery is at-least-once).
model ProcessedMessage {
  consumer    String   @db.VarChar(60)
  messageId   String   @map("message_id") @db.VarChar(64)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, messageId])
  @@map("processed_messages")
}

// ---------------------------------------------------------------------------------------------------------------
// Phase 6: shipping
// ---------------------------------------------------------------------------------------------------------------

enum ShipmentStatus {
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERED
  RETURNED_TO_SELLER
}

/// Admin-configured delivery options. With NO active method, shipping is free (documented default).
model ShippingMethod {
  id             String   @id @default(uuid(7)) @db.Uuid
  code           String   @unique @db.VarChar(30)
  name           String   @db.VarChar(80)
  description    String?  @db.VarChar(200)
  baseMinor      Int      @map("base_minor")
  freeAboveMinor Int?     @map("free_above_minor")
  etaMinDays     Int      @map("eta_min_days")
  etaMaxDays     Int      @map("eta_max_days")
  /// Indian state names served; empty = everywhere.
  states         String[]
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("shipping_methods")
}

/// One shipment per order (split shipments are a documented later extension).
model Shipment {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @unique @map("order_id") @db.Uuid
  carrier        String         @db.VarChar(60)
  trackingNumber String         @map("tracking_number") @db.VarChar(80)
  status         ShipmentStatus @default(IN_TRANSIT)
  shippedAt      DateTime       @default(now()) @map("shipped_at") @db.Timestamptz(6)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events ShipmentEvent[]

  @@unique([carrier, trackingNumber])
  @@map("shipments")
}

/// Append-only tracking history (immutable by trigger).
model ShipmentEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  shipmentId String         @map("shipment_id") @db.Uuid
  status     ShipmentStatus
  location   String?        @db.VarChar(120)
  note       String?        @db.VarChar(200)
  occurredAt DateTime       @map("occurred_at") @db.Timestamptz(6)
  actorId    String?        @map("actor_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// ---------------------------------------------------------------------------------------------------------------
// Phase 6: reviews and wishlists
// ---------------------------------------------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Only customers with a DELIVERED order containing the product can review it (verified purchase). One per product.
/// New and edited reviews are PENDING until a moderator approves them; only APPROVED reviews are public.
model ProductReview {
  id             String       @id @default(uuid(7)) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  rating         Int          @db.SmallInt
  title          String?      @db.VarChar(120)
  /// Plain text (markup is stripped on write); consumers must still escape on render.
  body           String       @db.VarChar(2000)
  status         ReviewStatus @default(PENDING)
  moderatedById  String?      @map("moderated_by_id") @db.Uuid
  moderatedAt    DateTime?    @map("moderated_at") @db.Timestamptz(6)
  moderationNote String?      @map("moderation_note") @db.VarChar(300)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([productId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("product_reviews")
}

model WishlistItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("wishlist_items")
}
