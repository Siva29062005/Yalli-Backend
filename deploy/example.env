# Copy to deploy/staging.env or deploy/production.env (both are git-ignored). No secrets here: the task definitions
# read database URLs and keys from Secrets Manager.
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
ECR_REPO_API=yalli-api
ECR_REPO_FRONTEND=yalli-frontend
ECS_CLUSTER=yalli-staging
ECS_SERVICE_API=yalli-api
ECS_SERVICE_WORKER=yalli-worker
ECS_SERVICE_FRONTEND=yalli-frontend
MIGRATE_TASK_FAMILY=yalli-migrate
MIGRATE_SUBNETS=subnet-aaaa,subnet-bbbb
MIGRATE_SECURITY_GROUPS=sg-cccc
# API_INTERNAL_URL and the NEXT_PUBLIC_* values for this environment's frontend build:
FRONTEND_BUILD_ENV=deploy/staging.frontend.env
