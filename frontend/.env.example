# Public store details shown on the policy and contact pages (baked in at build time: rebuild after changing them).
# Use YOUR real details; a blank value is left out of the page. In development the pages show a reminder for each gap.
# NEXT_PUBLIC_BUSINESS_TRADE_NAME=Yalli Marketing
# NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
# NEXT_PUBLIC_BUSINESS_ADDRESS=
# NEXT_PUBLIC_BUSINESS_GSTIN=
# NEXT_PUBLIC_BUSINESS_SELLER_STATE=Tamil Nadu
# Public https address of the storefront. Also drives canonical links, robots.txt and sitemap.xml: set it for production builds.
# NEXT_PUBLIC_BUSINESS_WEBSITE_URL=https://yalli.in
# NEXT_PUBLIC_BUSINESS_SUPPORT_EMAIL=
# NEXT_PUBLIC_BUSINESS_SUPPORT_PHONE=
# NEXT_PUBLIC_BUSINESS_SUPPORT_HOURS=
# Grievance officer (Consumer Protection (E-Commerce) Rules, 2020): name, designation and contact must be shown.
# NEXT_PUBLIC_BUSINESS_GRIEVANCE_OFFICER_NAME=
# NEXT_PUBLIC_BUSINESS_GRIEVANCE_OFFICER_DESIGNATION=
# NEXT_PUBLIC_BUSINESS_GRIEVANCE_OFFICER_EMAIL=
# NEXT_PUBLIC_BUSINESS_GRIEVANCE_OFFICER_PHONE=

# Backend that Next.js forwards /api/v1 to (read when `next start`/`next build` runs, see README).
# API_INTERNAL_URL=http://127.0.0.1:3000/api/v1

# Cloudflare Turnstile site key (public). Required for production: the backend refuses sign-up and password-reset
# requests without a captcha token (CAPTCHA_PROVIDER=turnstile). Leave unset in development with CAPTCHA_PROVIDER=none.
# Cloudflare's always-pass TEST pair: site key 1x00000000000000000000AA, backend secret 1x0000000000000000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Home page banner supplied by the owner: create frontend/public/banners/ and put the image there (WebP, JPEG, PNG or
# AVIF); the path starts at public/. Without it the hero shows a real product photo (never a stock photo).
# NEXT_PUBLIC_HOME_HERO_IMAGE=/banners/home-hero.webp
# NEXT_PUBLIC_HOME_HERO_ALT=

# Server-only (no NEXT_PUBLIC_): the same value as the backend's FRONTEND_SERVER_KEY (32+ random characters). Gives
# server-side catalogue reads their own rate-limit budget. Store it in the secrets manager, never in the repo.
# FRONTEND_SERVER_KEY=
